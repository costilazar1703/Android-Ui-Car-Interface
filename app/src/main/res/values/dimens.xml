<?xml version="1.0" encoding="utf-8"?>
<!--
  ATENȚIE: valorile în dp presupun ~160 dpi (1280x480 px = 1280x480 dp).
  Rulează `adb shell wm density` pe unitate ÎNAINTE de fine-tuning.
  Dacă raportează 240 dpi ai doar ~853x320 dp — reduce tot ce e mai jos cu ~1/3.
  Layout-ul în sine folosește procente (chain + Guideline), deci nu se sparge;
  doar textul și padding-urile trebuie recalibrate aici, într-un singur loc.
-->
<resources>
    <dimen name="screen_margin">10dp</dimen>
    <dimen name="card_gap">8dp</dimen>
    <dimen name="card_padding">12dp</dimen>
    <dimen name="card_corner">6dp</dimen>
    <dimen name="focus_stroke">2dp</dimen>
    <dimen name="idle_stroke">1dp</dimen>

    <!-- Rândurile de listă sunt intenționat mai înalte decât standardul Android (48dp). -->
    <dimen name="row_height">52dp</dimen>
    <dimen name="row_padding_h">14dp</dimen>
    <dimen name="divider_height">1dp</dimen>

    <dimen name="topbar_height">54dp</dimen>
    <!-- Lățime fixă pe orice se updatează des: fără WRAP_CONTENT, fără relayout. -->
    <dimen name="status_field_width">150dp</dimen>

    <dimen name="gauge_size_card">120dp</dimen>
    <dimen name="gauge_size_full">300dp</dimen>
    <dimen name="app_icon_size">56dp</dimen>
    <dimen name="app_cell_width">108dp</dimen>
    <dimen name="cover_size">150dp</dimen>
    <dimen name="cover_corner">14dp</dimen>
    <dimen name="transport_small">64dp</dimen>
    <dimen name="transport_big">84dp</dimen>
    <dimen name="mini_player_height">34dp</dimen>
    <dimen name="mini_player_cover">26dp</dimen>
    <dimen name="mini_player_text_max">220dp</dimen>
    <dimen name="mini_player_artist_max">140dp</dimen>

    <!-- Meniu principal. Înălțimea rândurilor NU e fixată aici: cele 5 rânduri
         împart pe verticală spațiul disponibil cu weight, ca să încapă exact 5
         indiferent de densitatea raportată de unitate. -->
    <dimen name="menu_icon_size">30dp</dimen>
    <dimen name="menu_row_padding_h">18dp</dimen>
    <dimen name="menu_row_gap">3dp</dimen>
    <dimen name="page_dot_size">7dp</dimen>

    <!-- Ecrane split (Setări, Bluetooth, Telefon) -->
    <dimen name="split_nav_row_height">46dp</dimen>
    <dimen name="detail_row_height">44dp</dimen>
    <!-- Randurile sunt placi detasate, nu o lista cu separatoare. -->
    <dimen name="detail_row_gap">4dp</dimen>
    <!-- Glow-ul cardului focusat. Straturile din <layer-list> sunt inset-ate cu
         acesti pasi: cu cat pasul e mai mare, cu atat halo-ul pare mai difuz.
         2dp/4dp sunt calibrate pentru 1280x480 la ~160dpi. -->
    <dimen name="glow_step">2dp</dimen>
    <dimen name="glow_body_inset">4dp</dimen>
    <dimen name="tile_marker_width">6dp</dimen>

    <!-- Pop-up-uri desenate peste ecranul curent (nu AlertDialog). -->
    <dimen name="overlay_panel_width">420dp</dimen>
    <dimen name="overlay_padding">14dp</dimen>
    <!-- Dalele ID6. Inset-urile sunt identice pe ambele stari ale selectorului,
         ca dala sa nu-si schimbe geometria cand primeste focus. -->
    <!-- Rotunjire discreta: destul cat sa nu mai fie un dreptunghi taiat,
         prea putin cat sa devina un buton de telefon. -->
    <dimen name="tile_corner">7dp</dimen>
    <dimen name="tile_glow_step">3dp</dimen>
    <dimen name="tile_body_inset">6dp</dimen>
    <!-- Golul dintre rama exterioara si cea interioara. -->
    <dimen name="tile_frame_inset">9dp</dimen>
    <!-- Contururile ramei duble a dalelor. Separate de focus_stroke/idle_stroke,
         care sunt comune cu randurile din meniuri si Setari: ingrosarea ramei
         dalelor nu trebuie sa ingroase si listele. -->
    <dimen name="tile_stroke_outer">2dp</dimen>
    <dimen name="tile_stroke_outer_focus">3dp</dimen>
    <dimen name="tile_stroke_inner">1.5dp</dimen>
    <!-- Rama din reflexie: mai subtire decat a dalei, ca sa para luciu, nu dubla. -->
    <dimen name="tile_reflection_stroke_outer">0.75dp</dimen>
    <dimen name="tile_reflection_stroke_outer_focus">1dp</dimen>
    <dimen name="tile_reflection_stroke_inner">0.75dp</dimen>
    <dimen name="tile_gap">4dp</dimen>
    <dimen name="tile_grid_margin_v">8dp</dimen>
    <!-- Bara de sus -->
    <dimen name="topbar_clock_size">32sp</dimen>
    <dimen name="topbar_icon">17dp</dimen>
</resources>

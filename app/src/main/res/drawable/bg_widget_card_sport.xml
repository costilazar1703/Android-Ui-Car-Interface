<?xml version="1.0" encoding="utf-8"?>
<!--
  Rama widget-urilor de pe Home în Dynamic Sport și Manual (cerut 2026-11-19): ramele devin
  portocalii. Selectat din rotiță: același stil ca în modul normal, în griul titlurilor
  din bara din stânga.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/widget_corner" />
                    <gradient
                        android:angle="315"
                        android:endColor="#66B8B8B8"
                        android:startColor="@color/sport_select" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <solid android:color="@color/widget_card_solid" />
                </shape>
            </item>
            <item
                android:bottom="5dp"
                android:left="5dp"
                android:right="5dp"
                android:top="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="17dp" />
                    <stroke android:width="1dp" android:color="#33B8B8B8" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/widget_corner" />
                    <gradient
                        android:angle="315"
                        android:endColor="#44D8380A"
                        android:startColor="#FFD8380A" />
                </shape>
            </item>
            <item
                android:bottom="1.5dp"
                android:left="1.5dp"
                android:right="1.5dp"
                android:top="1.5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="20.5dp" />
                    <solid android:color="@color/widget_card_solid" />
                </shape>
            </item>
            <item
                android:bottom="5dp"
                android:left="5dp"
                android:right="5dp"
                android:top="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="17dp" />
                    <stroke android:width="1dp" android:color="#2EF04A12" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Wi-Fi în bara de sus, din aceeași familie cu iconițele cromate ale dalelor:
     arce de metal cu lumină de sus, punct portocaliu la bază. Vector, nu PNG: la
     30 px arcele subțiri rămân curate. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="30dp"
    android:height="30dp"
    android:viewportWidth="30"
    android:viewportHeight="30">
    <!-- Arcul mare -->
    <path
        android:pathData="M3.5,12.5 C9.8,6.3 20.2,6.3 26.5,12.5"
        android:strokeLineCap="round"
        android:strokeWidth="2.6">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="15"
                android:endY="13"
                android:endColor="#FF7E7E7E"
                android:startX="15"
                android:startY="7"
                android:startColor="#FFF6F6F6"
                android:type="linear" />
        </aapt:attr>
    </path>
    <!-- Arcul mijlociu -->
    <path
        android:pathData="M8,17 C11.9,13.2 18.1,13.2 22,17"
        android:strokeLineCap="round"
        android:strokeWidth="2.6">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="15"
                android:endY="17.5"
                android:endColor="#FF7E7E7E"
                android:startX="15"
                android:startY="13"
                android:startColor="#FFF0F0F0"
                android:type="linear" />
        </aapt:attr>
    </path>
    <!-- Arcul mic, cald: leagă metalul de punctul portocaliu. -->
    <path
        android:pathData="M12,21 C13.7,19.5 16.3,19.5 18,21"
        android:strokeColor="#FFE9A27C"
        android:strokeLineCap="round"
        android:strokeWidth="2.4" />
    <!-- Halou și punct -->
    <path
        android:fillColor="#40E8541A"
        android:pathData="M15,25 m-3.6,0 a3.6,3.6 0 1,0 7.2,0 a3.6,3.6 0 1,0 -7.2,0" />
    <path
        android:fillColor="@color/glow_core"
        android:pathData="M15,25 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Voalul ecranelor de meniu, pe DIAGONALĂ.

  Fotografia de fundal (motorul) își ține subiectul în dreapta-sus, iar conținutul
  meniului stă jos-stânga. Un voal uniform ar înghiți exact partea care merită
  văzută. Gradientul la 45° pornește opac din colțul de jos-stânga, unde sunt
  rotița și rândurile, și se stinge complet spre dreapta-sus, unde e motorul.

  În Android, unghiul 45 înseamnă de la colțul stânga-jos spre dreapta-sus, deci
  startColor e cel de jos-stânga.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="45"
        android:startColor="#E6000000"
        android:centerColor="#73000000"
        android:endColor="@color/transparent"
        android:type="linear" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Banda de sub bara de status. Nu e un dreptunghi opac: se stinge spre bază,
     ca să nu taie fotografia cu o linie dreaptă. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#D9000000"
        android:centerColor="#8C000000"
        android:endColor="@color/transparent"
        android:type="linear" />
</shape>

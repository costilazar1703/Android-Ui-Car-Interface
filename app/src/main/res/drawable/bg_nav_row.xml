<?xml version="1.0" encoding="utf-8"?>
<!-- Categorie din coloana stângă. Selecția e plină aici: sunt trei-patru rânduri,
     nu douăzeci, iar categoria curentă trebuie să se vadă dintr-o privire. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/glow_core"
                android:endColor="#CCFF5E00"
                android:type="linear" />
            <corners android:radius="@dimen/card_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent" />
            <corners android:radius="@dimen/card_corner" />
        </shape>
    </item>
</selector>

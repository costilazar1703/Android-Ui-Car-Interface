<?xml version="1.0" encoding="utf-8"?>
<!-- Card de widget în stil iOS: colțuri mari, sticlă închisă semitransparentă, ramă fină.
     Focusat din rotiță: rama devine accentul portocaliu. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_corner" />
            <solid android:color="@color/widget_card_bg" />
            <stroke android:width="2dp" android:color="@color/accent_focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_corner" />
            <solid android:color="@color/widget_card_bg" />
            <stroke android:width="1dp" android:color="@color/widget_card_stroke" />
        </shape>
    </item>
</selector>

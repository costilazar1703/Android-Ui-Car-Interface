<?xml version="1.0" encoding="utf-8"?>
<!--
  Rama widget-urilor de pe Home, în stil iOS, cu două detalii:
   1. rama în degrade: lumină în colțul din stânga sus, stinsă spre dreapta jos (sticlă);
   2. o linie fină în interior, la 4dp de margine;
  Selectat din rotiță: rama trece în accent.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/widget_corner" />
                    <gradient
                        android:angle="315"
                        android:endColor="#66F04A12"
                        android:startColor="@color/accent_focus" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <solid android:color="@color/widget_card_solid" />
                </shape>
            </item>
            <item
                android:bottom="5dp"
                android:left="5dp"
                android:right="5dp"
                android:top="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="17dp" />
                    <stroke android:width="1dp" android:color="#33F04A12" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/widget_corner" />
                    <gradient
                        android:angle="315"
                        android:endColor="#0FFFFFFF"
                        android:startColor="#4DFFFFFF" />
                </shape>
            </item>
            <item
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="21dp" />
                    <solid android:color="@color/widget_card_solid" />
                </shape>
            </item>
            <item
                android:bottom="5dp"
                android:left="5dp"
                android:right="5dp"
                android:top="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="17dp" />
                    <stroke android:width="1dp" android:color="#12FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Chip-urile de jos (mini-player, telefonul conectat): aceeași sticlă ca dalele
     neselectate - gradient fumuriu de sus în jos și rama albă stinsă - dar în
     formă de pastilă. Destul de transparentă ca fotografia să se vadă prin ea. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/tile_idle_bottom"
        android:startColor="@color/tile_idle_top" />
    <stroke android:width="1dp" android:color="@color/tile_idle_stroke" />
    <corners android:radius="100dp" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Celula din ecranul Apps. Nu un card gri opac: neselectată e doar o sticlă
  abia vizibilă peste fotografie, selectată ia exact limbajul dalelor din
  meniul principal - gradient portocaliu de sus și rama aprinsă.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/glow_outer" />
                    <corners android:radius="@dimen/tile_corner" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:centerColor="@color/tile_focus_mid"
                        android:endColor="@color/tile_focus_bottom"
                        android:startColor="@color/tile_focus_top" />
                    <stroke
                        android:width="@dimen/tile_stroke_outer"
                        android:color="@color/glow_core" />
                    <corners android:radius="@dimen/tile_corner" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="#14FFFFFF"
                        android:startColor="#08FFFFFF" />
                    <stroke
                        android:width="0.75dp"
                        android:color="#1FFFFFFF" />
                    <corners android:radius="@dimen/tile_corner" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

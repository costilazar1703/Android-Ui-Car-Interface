<?xml version="1.0" encoding="utf-8"?>
<!-- Chenarul mic al logo-ului CarPlay din colțul barei de sus: aceeași ramă dublă ca
     widget-urile de pe Home (lumină în degrade + linie fină în interior), la scară mică. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="315"
                android:endColor="#0FFFFFFF"
                android:startColor="#4DFFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <solid android:color="@color/widget_card_solid" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#12FFFFFF" />
        </shape>
    </item>
</layer-list>

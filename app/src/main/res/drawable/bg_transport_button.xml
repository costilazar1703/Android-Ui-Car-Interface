<?xml version="1.0" encoding="utf-8"?>
<!-- Butoanele de transport, rotunde ca în iOS. Focusul (state_activated, pus de
     FocusEngine) aprinde inelul portocaliu; în repaus abia se văd, ca să lase
     coperta și titlul să conducă. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="#59FF6B00" />
            <stroke android:width="2dp" android:color="@color/accent_focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#1AFFFFFF" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>

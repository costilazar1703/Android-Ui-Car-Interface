<?xml version="1.0" encoding="utf-8"?>
<!-- Focus vizual: contur portocaliu, nu ripple Android. state_activated e setat de FocusEngine. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_focused" />
            <stroke android:width="@dimen/focus_stroke" android:color="@color/accent_focus" />
            <corners android:radius="@dimen/card_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="@dimen/idle_stroke" android:color="@color/stroke" />
            <corners android:radius="@dimen/card_corner" />
        </shape>
    </item>
</selector>

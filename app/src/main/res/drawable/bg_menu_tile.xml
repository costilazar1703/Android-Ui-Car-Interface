<?xml version="1.0" encoding="utf-8"?>
<!--
  Rândul unui meniu de nivel 2.

  Semi-transparent din același motiv ca dalele: fotografia de fundal trebuie să
  treacă prin el. Alfa stă în culori, nu într-un `alpha` pe view — acela ar fi
  stins și conturul, nu doar umplutura.

  Glow-ul vine din straturi, NU din elevation: pe API 27 elevation desenează o
  umbră neagră, care pe fundal întunecat nu se vede și lasă colțurile murdare.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/glow_outer" />
                    <corners android:radius="@dimen/card_corner" />
                </shape>
            </item>
            <item
                android:bottom="@dimen/glow_step"
                android:left="@dimen/glow_step"
                android:right="@dimen/glow_step"
                android:top="@dimen/glow_step">
                <shape android:shape="rectangle">
                    <solid android:color="@color/glow_mid" />
                    <corners android:radius="@dimen/card_corner" />
                </shape>
            </item>
            <item
                android:bottom="@dimen/glow_body_inset"
                android:left="@dimen/glow_body_inset"
                android:right="@dimen/glow_body_inset"
                android:top="@dimen/glow_body_inset">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="0"
                        android:startColor="@color/row_focus_start"
                        android:endColor="@color/row_focus_end"
                        android:type="linear" />
                    <stroke
                        android:width="@dimen/focus_stroke"
                        android:color="@color/glow_core" />
                    <corners android:radius="@dimen/card_corner" />
                </shape>
            </item>
            <!-- Bara de pe muchia din stânga: reperul ID6 care arată de unde
                 „intră" linia venită de la rotiță. -->
            <item
                android:width="@dimen/tile_marker_width"
                android:bottom="@dimen/glow_body_inset"
                android:gravity="start|fill_vertical"
                android:left="@dimen/glow_body_inset"
                android:top="@dimen/glow_body_inset">
                <shape android:shape="rectangle">
                    <solid android:color="@color/glow_core" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item
                android:bottom="@dimen/glow_body_inset"
                android:left="@dimen/glow_body_inset"
                android:right="@dimen/glow_body_inset"
                android:top="@dimen/glow_body_inset">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="0"
                        android:startColor="@color/row_idle_start"
                        android:endColor="@color/row_idle_end"
                        android:type="linear" />
                    <stroke
                        android:width="@dimen/idle_stroke"
                        android:color="@color/row_idle_stroke" />
                    <corners android:radius="@dimen/card_corner" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>

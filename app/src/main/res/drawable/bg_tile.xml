<?xml version="1.0" encoding="utf-8"?>
<!--
  Dala din meniul principal ID6.

  Halo-ul e construit din <layer-list>, nu din elevation: pe API 27 elevation
  desenează o umbră NEAGRĂ sub view, care pe fundal negru nu se vede deloc și, la
  colțuri, lasă un dreptunghi mai închis. Straturile de aici merg invers — cel
  mai din afară e cel mai transparent, fiecare inset următor e mai aprins — deci
  lumina pare că iese din dală, ca pe ecranul din mașină.

  Geometria e IDENTICĂ pe cele două stări (aceleași inset-uri): la mutarea
  focusului se schimbă doar culorile, nu poziția. Altfel dalele ar tresări.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_activated="true">
        <layer-list>

            <!-- Difuzia exterioară. -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/glow_outer" />
                    <corners android:radius="@dimen/tile_corner" />
                </shape>
            </item>

            <item
                android:bottom="@dimen/tile_glow_step"
                android:left="@dimen/tile_glow_step"
                android:right="@dimen/tile_glow_step"
                android:top="@dimen/tile_glow_step">
                <shape android:shape="rectangle">
                    <solid android:color="@color/glow_mid" />
                    <corners android:radius="@dimen/tile_corner" />
                </shape>
            </item>

            <!-- Corpul dalei. Gradientul urcă spre portocaliu în partea de sus,
                 ca reflexia de pe sticla din ID6. -->
            <item
                android:bottom="@dimen/tile_body_inset"
                android:left="@dimen/tile_body_inset"
                android:right="@dimen/tile_body_inset"
                android:top="@dimen/tile_body_inset">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="@color/tile_focus_top"
                        android:centerColor="@color/tile_focus_mid"
                        android:endColor="@color/tile_focus_bottom"
                        android:type="linear" />
                    <stroke
                        android:width="@dimen/focus_stroke"
                        android:color="@color/glow_core" />
                    <corners android:radius="@dimen/tile_corner" />
                </shape>
            </item>

        </layer-list>
    </item>

    <item>
        <layer-list>
            <item
                android:bottom="@dimen/tile_body_inset"
                android:left="@dimen/tile_body_inset"
                android:right="@dimen/tile_body_inset"
                android:top="@dimen/tile_body_inset">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="@color/tile_idle_top"
                        android:endColor="@color/tile_idle_bottom"
                        android:type="linear" />
                    <stroke
                        android:width="@dimen/idle_stroke"
                        android:color="@color/tile_idle_stroke" />
                    <corners android:radius="@dimen/tile_corner" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Dala din meniul principal ID6: ramă dublă, corp semi-transparent, halo la focus.

  **Semi-transparent, nu opac.** Fotografia din spate e subiectul, nu decorul.
  Corpul lasă lumina orașului și reflexiile de pe asfalt să treacă prin el, dar
  stă suficient de închis cât iconița albă să rămână lizibilă peste orice cade
  dedesubt. Alfa e în culori (`@color/tile_*`), nu pe view: un `alpha` pe view ar
  fi stins și conturul, nu doar umplutura.

  **Rama dublă** e desenată din două straturi inset-ate diferit, nu dintr-un
  stroke gros: un singur contur de 3 px arată ca o bordură, două de 1 px
  despărțite de un gol arată ca o ramă frezată — diferența dintre un dreptunghi
  desenat și o piesă montată în bord.

  Halo-ul vine din `<layer-list>`, NU din elevation: pe API 27 elevation desenează
  o umbră neagră, invizibilă pe fundal întunecat, iar peste o fotografie lasă și
  un dreptunghi mai murdar la colțuri.

  Geometria e IDENTICĂ pe cele două stări — se schimbă doar culorile. Altfel dala
  ar tresări la fiecare mutare de focus.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_activated="true">
        <layer-list>

            <!-- 1. Difuzia exterioară, cea mai transparentă. -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/glow_outer" />
                    <corners android:radius="@dimen/tile_corner" />
                </shape>
            </item>

            <!-- 2. Difuzia intermediară. -->
            <item
                android:bottom="@dimen/tile_glow_step"
                android:left="@dimen/tile_glow_step"
                android:right="@dimen/tile_glow_step"
                android:top="@dimen/tile_glow_step">
                <shape android:shape="rectangle">
                    <solid android:color="@color/glow_mid" />
                    <corners android:radius="@dimen/tile_corner" />
                </shape>
            </item>

            <!-- 3. Rama EXTERIOARĂ, aprinsă. -->
            <item
                android:bottom="@dimen/tile_body_inset"
                android:left="@dimen/tile_body_inset"
                android:right="@dimen/tile_body_inset"
                android:top="@dimen/tile_body_inset">
                <shape android:shape="rectangle">
                    <solid android:color="@color/transparent" />
                    <stroke
                        android:width="@dimen/focus_stroke"
                        android:color="@color/glow_core" />
                    <corners android:radius="@dimen/tile_corner" />
                </shape>
            </item>

            <!-- 4. Rama INTERIOARĂ + corpul. Gradientul urcă spre portocaliu în
                 partea de sus, ca reflexia de pe sticlă din mașină. -->
            <item
                android:bottom="@dimen/tile_frame_inset"
                android:left="@dimen/tile_frame_inset"
                android:right="@dimen/tile_frame_inset"
                android:top="@dimen/tile_frame_inset">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="@color/tile_focus_top"
                        android:centerColor="@color/tile_focus_mid"
                        android:endColor="@color/tile_focus_bottom"
                        android:type="linear" />
                    <stroke
                        android:width="@dimen/idle_stroke"
                        android:color="@color/tile_focus_inner_stroke" />
                    <corners android:radius="@dimen/tile_corner" />
                </shape>
            </item>

        </layer-list>
    </item>

    <!-- Neselectată: aceeași ramă dublă, doar stinsă. -->
    <item>
        <layer-list>

            <item
                android:bottom="@dimen/tile_body_inset"
                android:left="@dimen/tile_body_inset"
                android:right="@dimen/tile_body_inset"
                android:top="@dimen/tile_body_inset">
                <shape android:shape="rectangle">
                    <solid android:color="@color/transparent" />
                    <stroke
                        android:width="@dimen/idle_stroke"
                        android:color="@color/tile_idle_stroke" />
                    <corners android:radius="@dimen/tile_corner" />
                </shape>
            </item>

            <item
                android:bottom="@dimen/tile_frame_inset"
                android:left="@dimen/tile_frame_inset"
                android:right="@dimen/tile_frame_inset"
                android:top="@dimen/tile_frame_inset">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="@color/tile_idle_top"
                        android:endColor="@color/tile_idle_bottom"
                        android:type="linear" />
                    <stroke
                        android:width="@dimen/idle_stroke"
                        android:color="@color/tile_idle_inner_stroke" />
                    <corners android:radius="@dimen/tile_corner" />
                </shape>
            </item>

        </layer-list>
    </item>

</selector>

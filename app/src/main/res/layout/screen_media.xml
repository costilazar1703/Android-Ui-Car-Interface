<?xml version="1.0" encoding="utf-8"?>
<!--
  „Now Playing" în stil iOS: coperta rotunjită în stânga; bara de progres stă
  exact la jumătatea înălțimii copertei, titlul se clădește deasupra ei, iar
  timpii și transportul (butoane rotunde) dedesubt. Alegerea sursei e o pastilă mică sub copertă, doar când chiar sunt
  mai multe; dreapta rămâne liberă pentru fotografia de fundal.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="14dp"
    android:paddingEnd="0dp"
    android:paddingBottom="14dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gSplit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.80" />

    <!-- ============================= COPERTA ============================ -->
    <ImageView
        android:id="@+id/imgCover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="28dp"
        android:contentDescription="@null"
        android:elevation="10dp"
        android:scaleType="centerCrop"
        android:src="@drawable/media_cover_default"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="W,1:1"
        app:layout_constraintHeight_percent="0.68"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ========================= TITLU + PROGRES ======================== -->
    <TextView
        android:id="@+id/lblNowPlaying"
        style="@style/Text.Label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/media_now_playing"
        android:textAllCaps="true"
        android:textColor="@color/accent_focus"
        android:letterSpacing="0.2"
        app:layout_constraintEnd_toEndOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="@id/txtTitle"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/txtTitle" />

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_semibold"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="32sp"
        app:layout_constraintEnd_toStartOf="@id/gSplit"
        app:layout_constraintStart_toEndOf="@id/imgCover"
        tools:text="Bohemian Rhapsody"
        app:layout_constraintBottom_toTopOf="@id/txtArtist" />

    <TextView
        android:id="@+id/txtArtist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/inter_regular"
        android:singleLine="true"
        android:textColor="#D9FFFFFF"
        android:textSize="21sp"
        app:layout_constraintEnd_toEndOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="@id/txtTitle"
        tools:text="Queen"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toTopOf="@id/txtAlbum" />

    <TextView
        android:id="@+id/txtAlbum"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/inter_regular"
        android:singleLine="true"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="@id/txtTitle"
        tools:text="A Night at the Opera"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/progressTrack" />

    <ProgressBar
        android:id="@+id/progressTrack"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:max="1000"
        android:progressDrawable="@drawable/progress_media"
        app:layout_constraintEnd_toEndOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="@id/txtTitle"
        tools:progress="300"
        app:layout_constraintTop_toTopOf="@id/imgCover"
        app:layout_constraintBottom_toBottomOf="@id/imgCover" />

    <TextView
        android:id="@+id/txtElapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_medium"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@id/txtTitle"
        tools:text="1:24"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/progressTrack" />

    <TextView
        android:id="@+id/txtRemaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_medium"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        app:layout_constraintBaseline_toBaselineOf="@id/txtElapsed"
        app:layout_constraintEnd_toEndOf="@id/txtTitle"
        tools:text="-4:31" />

    <!-- ============================ TRANSPORT =========================== -->
    <!-- Focusabile din rotiță, dar și acționabile din butoanele de volan. -->
    <ImageView
        android:id="@+id/btnPrev"
        android:layout_width="@dimen/transport_small"
        android:layout_height="@dimen/transport_small"
        android:layout_marginEnd="26dp"
        android:background="@drawable/bg_transport_button"
        android:contentDescription="@null"
        android:padding="19dp"
        android:src="@drawable/ic_transport_prev"
        app:layout_constraintBottom_toBottomOf="@id/btnPlay"
        app:layout_constraintEnd_toStartOf="@id/btnPlay"
        app:layout_constraintTop_toTopOf="@id/btnPlay" />

    <ImageView
        android:id="@+id/btnPlay"
        android:layout_width="@dimen/transport_big"
        android:layout_height="@dimen/transport_big"
        android:background="@drawable/bg_transport_button"
        android:contentDescription="@null"
        android:padding="25dp"
        android:src="@drawable/ic_transport_play"
        app:layout_constraintEnd_toEndOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="@id/txtTitle"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/txtElapsed" />

    <ImageView
        android:id="@+id/btnNext"
        android:layout_width="@dimen/transport_small"
        android:layout_height="@dimen/transport_small"
        android:layout_marginStart="26dp"
        android:background="@drawable/bg_transport_button"
        android:contentDescription="@null"
        android:padding="19dp"
        android:src="@drawable/ic_transport_next"
        app:layout_constraintBottom_toBottomOf="@id/btnPlay"
        app:layout_constraintStart_toEndOf="@id/btnPlay"
        app:layout_constraintTop_toTopOf="@id/btnPlay" />

    <!-- ============================== SURSA ============================= -->
    <!-- Apare doar când cântă cel puțin două aplicații (ex. Spotify și telefonul
         pe Bluetooth). Apăsată, trece la sursa următoare. Stă în stânga jos,
         sub copertă, ca să nu acopere fotografia din dreapta. -->
    <TextView
        android:id="@+id/btnSource"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:background="@drawable/bg_source_chip"
        android:drawablePadding="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_medium"
        android:gravity="center_vertical"
        android:maxWidth="320dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/imgCover"
        app:layout_constraintTop_toBottomOf="@id/imgCover"
        tools:text="Source · Spotify"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>

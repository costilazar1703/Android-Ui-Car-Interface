<?xml version="1.0" encoding="utf-8"?>
<!--
  Shell-ul aplicației: bară de status (non-focusabilă, pur informativă, ca la iDrive)
  + containerul de ecrane. Un singur ConstraintLayout, plat.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:keepScreenOn="true">

    <!-- ============================ FUNDAL ============================== -->
    <!-- O SINGURA instanta pentru tot launcher-ul, in spatele containerului de
         ecrane. Alternativa - cate un fundal in layout-ul fiecarui ecran - ar
         decoda bitmap-ul din nou la fiecare push si ar tine doua copii in
         memorie cat timp un ecran e acoperit. Asa, imaginea se schimba printr-un
         fade cand se schimba nivelul, si atat. -->
    <ImageView
        android:id="@+id/screenBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        tools:src="@drawable/bg_home"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Al doilea ImageView, transparent in mod normal: fade-ul intre doua
         imagini cere ambele pe ecran simultan. -->
    <ImageView
        android:id="@+id/screenBackgroundNext"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Banda de sub bara de status: fara ea, ceasul si SSID-ul cad peste luna
         sau peste farurile masinii si devin ilizibile. -->
    <View
        android:id="@+id/topBarScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/scrim_topbar"
        app:layout_constraintBottom_toBottomOf="@id/gTopBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gTopBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.115" />

    <!-- Aceeași placă, în oglindă, în spatele temperaturii și iconițelor. -->
    <ro.e92.launcher.ui.widget.TopPlateView
        android:id="@+id/topPlateRight"
        android:layout_width="400dp"
        android:layout_height="0dp"
        android:scaleX="-1"
        app:layout_constraintBottom_toTopOf="@id/gTopBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Placa din spatele autonomiei. -->
    <ro.e92.launcher.ui.widget.TopPlateView
        android:id="@+id/topPlate"
        android:layout_width="400dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/gTopBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      Bara de sus, în trei zone:

        [⛽ 512 km]          [ 14:32 | Sun, 1 Nov ]          [14.5°  wifi]
                                     | MENU       ]

      Stânga autonomia, cu pompa; la mijloc ceasul mare și subțire (Inter Light),
      cu data și numele ecranului stivuite lângă el; dreapta temperatura de afară
      și iconițele care se aprind când sunt conectate. Melodia nu mai stă aici:
      o arată deja dala Media și mini-player-ul de jos.
    -->
    <LinearLayout
        android:id="@+id/rangeBlock"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/screen_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@id/gTopBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_status_fuel"
            android:tint="@color/glow_core" />

        <!-- Autonomia mare, procentul mic alături, bara de rezervor dedesubt. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/statusRange"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_display_light"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_primary"
                    android:textSize="25sp"
                    tools:text="512 km" />

                <TextView
                    android:id="@+id/statusFuelPct"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/inter_display_light"
                    android:includeFontPadding="false"
                    android:textColor="@color/tile_label_idle"
                    android:textSize="14sp"
                    tools:text="68%" />
            </LinearLayout>

            <ro.e92.launcher.ui.widget.FuelBarView
                android:id="@+id/fuelBar"
                android:layout_width="180dp"
                android:layout_height="11dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/centerBlock"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/gTopBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="@font/inter_display_light"
            android:fontFeatureSettings="tnum"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/topbar_clock_size"
            tools:text="14:32" />

        <View
            android:id="@+id/clockRule"
            android:layout_width="@dimen/divider_height"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@color/split_divider" />

        <LinearLayout
            android:id="@+id/titleBlock"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="Sun, 1 Nov" />

            <TextView
                android:id="@+id/screenTitle"
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/accent_focus"
                android:textSize="12sp"
                tools:text="MENU" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/statusIcons"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/screen_margin"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/gTopBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Temperatura exterioară, din CAN-ul unității KSW. -->
        <TextView
            android:id="@+id/statusTemp"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/inter_display_light"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:textColor="@color/text_primary"
            android:textSize="25sp"
            android:visibility="gone"
            tools:text="14.5°"
            tools:visibility="visible" />

        <ro.e92.launcher.ui.widget.WifiIconView
            android:id="@+id/icWifi"
            android:layout_width="@dimen/topbar_icon"
            android:layout_height="@dimen/topbar_icon" />
    </LinearLayout>

    <View
        android:id="@+id/topDivider"
        android:layout_width="0dp"
        android:layout_height="@dimen/divider_height"
        android:background="@color/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/gTopBar" />

    <FrameLayout
        android:id="@+id/screenContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topDivider" />

    <!-- Bara de jos, pe toate ecranele: Back și Home, telefonul, pagina curentă,
         muzica. Celelalte ecrane își lasă jos [bottom_chips_space] liber; dalele
         meniului principal rămân la locul lor, iar reflexiile intră sub bară. -->
    <ImageView
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_bar_height"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_bottom_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bara fără Home, Back și telefon: rama argintie merge continuu până la margini.
         În dreapta treptei din mijloc (se termină la ~864 din 1280 px): piesa, apoi
         înapoi / play / înainte. Stânga e liberă. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gBarMusic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.675" />

    <!-- Mijlocul barei: indicatorul de pagini pe dale, numele meniului în rest. -->
    <FrameLayout
        android:id="@+id/barPages"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/barTitle"
        style="@style/Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:letterSpacing="0.14"
        android:singleLine="true"
        android:textColor="@color/tile_label_idle"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="BLUETOOTH" />

    <!-- Muzica: cât de mare încape între liniile argintii ale barei. Apare doar cât
         cântă ceva; atingerea pe titlu deschide Media. -->
    <LinearLayout
        android:id="@+id/miniPlayer"
        android:layout_width="0dp"
        android:layout_height="@dimen/bar_inner_height"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="@dimen/bar_inner_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/gBarMusic"
        tools:visibility="visible">

        <TextView
            android:id="@+id/miniTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:ellipsize="end"
            android:fontFamily="@font/inter_regular"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/tile_label_idle"
            android:textSize="@dimen/bar_song_text"
            tools:text="Midnight City" />

        <ImageView
            android:id="@+id/miniPrev"
            android:layout_width="@dimen/bar_inner_height"
            android:layout_height="@dimen/bar_inner_height"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_transport_prev"
            android:tint="@color/tile_label_idle" />

        <ImageView
            android:id="@+id/miniPlay"
            android:layout_width="@dimen/bar_inner_height"
            android:layout_height="@dimen/bar_inner_height"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_transport_play"
            android:tint="@color/tile_label_idle" />

        <ImageView
            android:id="@+id/miniNext"
            android:layout_width="@dimen/bar_inner_height"
            android:layout_height="@dimen/bar_inner_height"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_transport_next"
            android:tint="@color/tile_label_idle" />
    </LinearLayout>

    <TextView
        android:id="@+id/alertBanner"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_alert_banner"
        android:elevation="8dp"
        android:paddingStart="22dp"
        android:paddingTop="10dp"
        android:paddingEnd="22dp"
        android:paddingBottom="10dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topDivider"
        tools:text="Handbrake is on"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>

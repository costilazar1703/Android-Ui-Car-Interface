<?xml version="1.0" encoding="utf-8"?>
<!--
  Patru cadrane centrate pe ecran, ca în bord: turbo și ulei, mici, pe margini;
  viteză și turații, mari, la mijloc. Cele mici stau mai jos, ca ceasurile
  auxiliare dintr-un bord sport.

  Mărimile se calculează în DashboardScreen.sizeGauges(), nu aici: un lanț
  ConstraintLayout cu raport 1:1 pe toate patru le micșora pe cele mari la
  mărimea celor mici.

  Avertizările (frână de mână, uși, marșarier) stau pe un singur rând jos, în
  V-ul dintre cele două cercuri mari, unde nu acoperă nicio gradație.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="4dp"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/gaugeRow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal">

        <ro.e92.launcher.ui.widget.GaugeView
            android:id="@+id/gaugeBoost"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <ro.e92.launcher.ui.widget.GaugeView
            android:id="@+id/gaugeSpeed"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <ro.e92.launcher.ui.widget.GaugeView
            android:id="@+id/gaugeRpm"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <ro.e92.launcher.ui.widget.GaugeView
            android:id="@+id/gaugeOil"
            android:layout_width="0dp"
            android:layout_height="0dp" />
    </LinearLayout>

    <!-- Marșarierul e doar afișat; NU declanșează niciun overlay video
         (camera și senzorii sunt ai unității, non-goal explicit). -->
    <TextView
        android:id="@+id/txtWarnings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/inter_semibold"
        android:letterSpacing="0.12"
        android:textColor="@color/warn_amber"
        android:textSize="14sp"
        tools:text="HANDBRAKE · REVERSE" />

    <TextView
        android:id="@+id/txtSource"
        style="@style/Text.Mono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="4dp"
        android:alpha="0.6"
        tools:text="source: mock" />

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Meniul de nivel 2: rotița în stânga-jos, rândurile în dreapta-jos.

      ┌──────────────────────────────────────────────┐
      │                            (fotografia)      │  ← treimea de sus, liberă
      │   ╭───╮                                      │
      │   │ ◉ │ ~~~~~  [ rând ]                      │
      │   ╰───╯        [ rând ]              • ○     │
      └──────────────────────────────────────────────┘

  Treimea de sus rămâne GOALĂ intenționat: un ecran plin până sus, cu doar patru
  rânduri de conținut, arată înghesuit. Aerul de deasupra e ce face diferența
  dintre un meniu de mașină și o listă de setări Android.

  Costul e că intră 4 rânduri pe pagină în loc de 5 — vezi PAGE_SIZE în
  WheelMenuScreen. Meniurile cu 5 intrări capătă a doua pagină, semnalată de
  punctele din dreapta-jos.

  Pozițiile sunt procentuale (Guideline), deci nu depind de densitatea raportată
  de unitate. Rândurile se construiesc în cod și împart înălțimea cu weight.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fundalul ecranelor de meniu: un gradient simplu, nu o fotografie.
         Ecranele astea sunt de lucru — te uiți la ce scrie pe rând. -->
    <View
        android:id="@+id/menuScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_menu_screen"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Linia de unde începe conținutul. Tot ce e deasupra e fotografie curată. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gContentTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.36" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gWheelEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.235" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gListStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.295" />

    <!-- ============================== ROTIȚA ============================= -->
    <!-- Rotița stă pe toată înălțimea și centrată, nu coborâtă odată cu
         rândurile: e ancora vizuală a ecranului, iar din centrul ei pleacă
         linia. Coborâtă, arăta ca o piesă care a alunecat în colț. -->
    <ro.e92.launcher.ui.widget.IDriveWheelView
        android:id="@+id/wheel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/gWheelEnd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Iconița rândului focusat, în centrul rotiței. Se schimbă instantaneu la
         fiecare mutare de focus. -->
    <ImageView
        android:id="@+id/wheelIcon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@id/wheel"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@id/wheel"
        app:layout_constraintStart_toStartOf="@id/wheel"
        app:layout_constraintTop_toTopOf="@id/wheel"
        app:layout_constraintVertical_bias="0.42"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.062"
        tools:src="@drawable/ic_menu_media" />

    <TextView
        android:id="@+id/wheelLabel"
        style="@style/Text.Label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:textColor="@color/accent_focus"
        app:layout_constraintEnd_toEndOf="@id/wheel"
        app:layout_constraintStart_toStartOf="@id/wheel"
        app:layout_constraintTop_toBottomOf="@id/wheelIcon"
        tools:text="MEDIA" />

    <!-- ============================= CONECTOR ============================ -->
    <!-- Pe toată înălțimea, nu doar cât rotița: rândurile sunt mai jos decât
         centrul ei, iar un view mai scurt ar tăia capătul curbei la desenare. -->
    <ro.e92.launcher.ui.widget.ConnectorView
        android:id="@+id/connector"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/gListStart"
        app:layout_constraintStart_toStartOf="@id/gWheelEnd"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- =============================== LISTĂ ============================= -->
    <FrameLayout
        android:id="@+id/viewport"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/screen_margin"
        android:clipChildren="true"
        android:clipToPadding="true"
        app:layout_constraintBottom_toTopOf="@id/pageDots"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/gListStart"
        app:layout_constraintTop_toTopOf="@id/gContentTop">

        <!-- Banda cu paginile. Lățimea se fixează în cod, după măsurare;
             schimbarea de pagină e o translație. -->
        <LinearLayout
            android:id="@+id/pageStrip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/pageDots"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

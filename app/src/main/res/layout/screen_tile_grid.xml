<?xml version="1.0" encoding="utf-8"?>
<!--
  Meniul principal EVO ID5/ID6: 6 dale pe pagină, 2 pagini.

    [ dală ][ dală ][ dală ][ dală ][ dală ][ dală ]   • ○

  Aceeași mecanică de paginare ca la ecranele cu rotiță: banda conține toate
  paginile una după alta, iar schimbarea de pagină e o translație pe X. Focusul
  e sursa de adevăr — pagina îl urmează, nu invers.

  Nu e RecyclerView: dalele sunt 12, fixe, și fiecare primește o transformare 3D
  proprie. Reciclarea ar complica exact partea care trebuie să fie stabilă.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Voal slab peste fotografia cu mașina: dalele semi-transparente își aduc
         singure contrastul, aici doar așezăm baza ecranului. -->
    <View
        android:id="@+id/homeScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/scrim_home"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Viewport-ul taie exact o pagină. Banda dinăuntru e mai lată decât el. -->
    <FrameLayout
        android:id="@+id/tileViewport"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="true"
        android:clipToPadding="true"
        app:layout_constraintBottom_toTopOf="@id/tilePageDots"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/tileStrip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:orientation="horizontal" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/tilePageDots"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="UselessLeaf" />

    <!-- Mini-player: apare doar cât există o sursă media. Atingerea pe text
         deschide ecranul Media, pe buton face play/pauză. Din rotiță nu e
         focusabil — butoanele de volan comandă oricum muzica de oriunde. -->
    <LinearLayout
        android:id="@+id/miniPlayer"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/mini_player_height"
        android:layout_marginEnd="@dimen/screen_margin"
        android:background="@drawable/bg_mini_player"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="3dp"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/miniCover"
            android:layout_width="@dimen/mini_player_cover"
            android:layout_height="@dimen/mini_player_cover"
            android:background="@drawable/bg_mini_cover"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/media_cover_default" />

        <ro.e92.launcher.ui.widget.EqualizerView
            android:id="@+id/miniEq"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginStart="9dp" />

        <TextView
            android:id="@+id/miniTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_medium"
            android:maxWidth="@dimen/mini_player_text_max"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            tools:text="Midnight City" />

        <TextView
            android:id="@+id/miniArtist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_regular"
            android:maxWidth="@dimen/mini_player_artist_max"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="M83" />

        <ImageView
            android:id="@+id/miniPlay"
            android:layout_width="@dimen/mini_player_cover"
            android:layout_height="@dimen/mini_player_cover"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_transport_play" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

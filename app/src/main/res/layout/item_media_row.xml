<?xml version="1.0" encoding="utf-8"?>
<!-- Rând iDrive: înalt, separator subțire dedesubt, highlight pe toată lățimea. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/row_height"
    android:background="@drawable/bg_list_row">

    <TextView
        android:id="@+id/rowTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:fontFamily="sans-serif-condensed"
        android:paddingStart="@dimen/row_padding_h"
        android:paddingEnd="@dimen/row_padding_h"
        android:singleLine="true"
        android:textColor="@color/list_row_text"
        android:textSize="17sp"
        app:layout_constraintBottom_toTopOf="@id/rowSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Spotify" />

    <TextView
        android:id="@+id/rowSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:fontFamily="sans-serif-condensed"
        android:paddingStart="@dimen/row_padding_h"
        android:paddingEnd="@dimen/row_padding_h"
        android:singleLine="true"
        android:textColor="@color/list_row_text_secondary"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rowTitle"
        tools:text="playing" />

    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/divider_height"
        android:background="@color/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

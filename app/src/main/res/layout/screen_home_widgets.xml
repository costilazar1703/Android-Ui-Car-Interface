<?xml version="1.0" encoding="utf-8"?>
<!--
  Ecranul Home (MENU pe consolă), primul dintre cele trei: bara verticală cu meniurile
  rapide în stânga, mașina din fotografia de fundal, două widget-uri în dreapta.
  Fără dale. Spre dreapta (swipe sau rotița după ultimul widget) urmează paginile de dale.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Bara verticală: MEDIA, CAR, DASH, SETUP. Rândurile se pun din cod. -->
    <LinearLayout
        android:id="@+id/rail"
        android:layout_width="@dimen/home_rail_width"
        android:layout_height="0dp"
        android:background="@color/home_rail_bg"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="@color/widget_card_stroke"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/rail"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Mașina care se rotește cu degetul, între bară și widget-uri. -->
    <ro.e92.launcher.ui.widget.CarSpinView
        android:id="@+id/carSpin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/gWidgets"
        app:layout_constraintStart_toEndOf="@id/rail"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gWidgets"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.555" />

    <LinearLayout
        android:id="@+id/widgetColumn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="36dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/gWidgets"
        app:layout_constraintTop_toTopOf="parent">

        <!-- ============================ MEDIA ============================ -->
        <LinearLayout
            android:id="@+id/mediaCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.25"
            android:background="@drawable/bg_widget_card"
            android:orientation="vertical"
            android:padding="@dimen/widget_pad">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/mediaLogo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_home_media" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/mediaTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_semibold"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        tools:text="Midnight City" />

                    <TextView
                        android:id="@+id/mediaArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_regular"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp"
                        tools:text="M83 · Bluetooth" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Ca la Apple CarPlay: glife albe pline, fără cerc în spate. -->
                <ImageView
                    android:id="@+id/mediaPrev"
                    android:layout_width="58dp"
                    android:layout_height="52dp"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:src="@drawable/ic_cp_prev" />

                <ImageView
                    android:id="@+id/mediaPlay"
                    android:layout_width="64dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="34dp"
                    android:layout_marginEnd="34dp"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:src="@drawable/ic_cp_play" />

                <ImageView
                    android:id="@+id/mediaNext"
                    android:layout_width="58dp"
                    android:layout_height="52dp"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:src="@drawable/ic_cp_next" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <!-- ========================== BLUETOOTH ========================== -->
        <LinearLayout
            android:id="@+id/btCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.75"
            android:background="@drawable/bg_widget_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/widget_pad"
            android:paddingEnd="@dimen/widget_pad">

            <ImageView
                android:id="@+id/btIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_home_bt" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    tools:text="iPhone" />

                <TextView
                    android:id="@+id/btStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_regular"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    tools:text="Music connected" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

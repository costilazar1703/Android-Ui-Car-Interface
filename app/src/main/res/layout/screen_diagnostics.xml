<?xml version="1.0" encoding="utf-8"?>
<!--
  Ecranul care face debug-ul posibil FĂRĂ laptop. Ciclul prin stick USB e prea
  lent ca să pui logcat pentru fiecare verificare, iar mașina nu stă lângă birou.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="4dp"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="4dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gSplit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.42" />

    <TextView
        android:id="@+id/lblKeys"
        style="@style/Text.Label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/diag_keys"
        app:layout_constraintEnd_toStartOf="@id/gSplit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollKeys"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/btnClear"
        app:layout_constraintEnd_toStartOf="@id/gSplit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblKeys">

        <TextView
            android:id="@+id/txtKeys"
            style="@style/Text.Mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            tools:text="23 KEYCODE_DPAD_CENTER → SELECT 0s" />
    </ScrollView>

    <TextView
        android:id="@+id/btnClear"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_card"
        android:fontFamily="sans-serif-condensed"
        android:gravity="center"
        android:text="@string/diag_clear"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/gSplit"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/lblState"
        style="@style/Text.Label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/diag_state"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/gSplit"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollState"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/btnSettings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/gSplit"
        app:layout_constraintTop_toBottomOf="@id/lblState">

        <TextView
            android:id="@+id/txtState"
            style="@style/Text.Mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            tools:text="speed = 62 km/h" />
    </ScrollView>

    <TextView
        android:id="@+id/btnSettings"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_card"
        android:fontFamily="sans-serif-condensed"
        android:gravity="center"
        android:text="@string/tile_settings"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/gSplit" />

</androidx.constraintlayout.widget.ConstraintLayout>
